{
  "rules": {
    "agrosahagun_db": {
      "users": {
        ".read": "root.child('agrosahagun_db/users/' + auth.uid + '/role').val() === 'admin'",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "root.child('agrosahagun_db/users/' + auth.uid + '/role').val() === 'admin'",
          "role": { ".validate": "newData.val() === 'admin' || newData.val() === 'operario'" },
          "active": { ".validate": "newData.isBoolean()" }
        }
      },
      "crops": {
        ".read": "root.child('agrosahagun_db/users/' + auth.uid + '/active').val() === true",
        ".write": "root.child('agrosahagun_db/users/' + auth.uid + '/active').val() === true"
      },
      "logs": {
        ".read": "root.child('agrosahagun_db/users/' + auth.uid + '/active').val() === true",
        ".write": "root.child('agrosahagun_db/users/' + auth.uid + '/active').val() === true"
      }
    }
  }
}
